[
 {
  "i": 0,
  "start": 0.19,
  "end": 3.37,
  "text": "I took one tiny pill, and it started a war inside my body."
 },
 {
  "i": 1,
  "start": 3.646,
  "end": 5.446,
  "text": "But the real enemy wasn't what I expected."
 },
 {
  "i": 2,
  "start": 5.947,
  "end": 7.007,
  "text": "It started with a sore throat."
 },
 {
  "i": 3,
  "start": 7.409,
  "end": 7.669,
  "text": "Ugh."
 },
 {
  "i": 4,
  "start": 7.829,
  "end": 8.729,
  "text": "My throat is on fire."
 },
 {
  "i": 5,
  "start": 9.183,
  "end": 9.863,
  "text": "Nice warm throat!"
 },
 {
  "i": 6,
  "start": 10.123,
  "end": 10.683,
  "text": "Let's move in!"
 },
 {
  "i": 7,
  "start": 10.996,
  "end": 11.156,
  "text": "Split!"
 },
 {
  "i": 8,
  "start": 11.276,
  "end": 11.456,
  "text": "Split!"
 },
 {
  "i": 9,
  "start": 11.596,
  "end": 11.876,
  "text": "Split!"
 },
 {
  "i": 10,
  "start": 12.273,
  "end": 15.313,
  "text": "An army of bacteria invaded my body, multiplying rapidly."
 },
 {
  "i": 11,
  "start": 15.993,
  "end": 17.193,
  "text": "And every hour, I got weaker."
 },
 {
  "i": 12,
  "start": 17.714,
  "end": 21.474,
  "text": "Wait, how can one tiny pill defeat an entire army of invisible monsters?"
 },
 {
  "i": 13,
  "start": 22.133,
  "end": 22.573,
  "text": "Just watch."
 },
 {
  "i": 14,
  "start": 23.052,
  "end": 23.792,
  "text": "I swallowed the antibiotic."
 },
 {
  "i": 15,
  "start": 25.072,
  "end": 27.032,
  "text": "Suddenly, millions of bacteria started collapsing."
 },
 {
  "i": 16,
  "start": 27.416,
  "end": 27.716,
  "text": "My wall!"
 },
 {
  "i": 17,
  "start": 27.936,
  "end": 28.276,
  "text": "It's cracking!"
 },
 {
  "i": 18,
  "start": 28.738,
  "end": 29.218,
  "text": "I can't split!"
 },
 {
  "i": 19,
  "start": 29.358,
  "end": 30.078,
  "text": "Why can't I split?"
 },
 {
  "i": 20,
  "start": 30.472,
  "end": 31.792,
  "text": "Some lost their protective walls."
 },
 {
  "i": 21,
  "start": 32.212,
  "end": 33.332,
  "text": "Others could no longer reproduce."
 },
 {
  "i": 22,
  "start": 33.972,
  "end": 35.132,
  "text": "But a few bacteria survived."
 },
 {
  "i": 23,
  "start": 35.706,
  "end": 36.926,
  "text": "Is that all you've got?"
 },
 {
  "i": 24,
  "start": 37.769,
  "end": 39.269,
  "text": "Then, something terrifying happens."
 },
 {
  "i": 25,
  "start": 39.717,
  "end": 40.097,
  "text": "Boys."
 },
 {
  "i": 26,
  "start": 40.097,
  "end": 40.837,
  "text": "Multiply."
 },
 {
  "i": 27,
  "start": 41.598,
  "end": 43.758,
  "text": "The surviving bacteria began multiplying again."
 },
 {
  "i": 28,
  "start": 44.458,
  "end": 46.498,
  "text": "This time, the medicine didn't work against them."
 },
 {
  "i": 29,
  "start": 46.917,
  "end": 47.757,
  "text": "Why isn't it working anymore?"
 },
 {
  "i": 30,
  "start": 48.316,
  "end": 49.336,
  "text": "Because they've become resistant."
 },
 {
  "i": 31,
  "start": 50.197,
  "end": 52.897,
  "text": "You see, antibiotics don't teach your body to fight bacteria."
 },
 {
  "i": 32,
  "start": 53.657,
  "end": 56.257,
  "text": "They work by killing bacteria or stopping them from growing."
 },
 {
  "i": 33,
  "start": 56.646,
  "end": 57.966,
  "text": "So what happens if we use them wrong?"
 },
 {
  "i": 34,
  "start": 58.333,
  "end": 62.633,
  "text": "When antibiotics are used incorrectly, resistant bacteria can survive and multiply."
 },
 {
  "i": 35,
  "start": 63.793,
  "end": 66.153,
  "text": "Eventually, medicines that once worked may no longer work."
 },
 {
  "i": 36,
  "start": 66.679,
  "end": 67.459,
  "text": "The scariest part?"
 },
 {
  "i": 37,
  "start": 67.799,
  "end": 69.179,
  "text": "Antibiotics don't become weaker."
 },
 {
  "i": 38,
  "start": 69.603,
  "end": 71.063,
  "text": "The bacteria become harder to kill."
 }
]