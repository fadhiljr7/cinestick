 },
 {
  "id": "d22",
  "who": "maya",
  "vo": false,
  "voice": "af_heart",
  "speed": 1.08,
  "text": "When antibiotics are used incorrectly, resistant bacteria can survive and multiply. Eventually, medicines that once worked may no longer work.",
